{
  "name": "neonsales-clickup-mcp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "wrangler dev",
    "format:check": "prettier --check src tests package.json tsconfig*.json eslint.config.js wrangler.jsonc",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc -p tsconfig.auth.json --noEmit && tsc -p tsconfig.mcp.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.1.12",
    "@cloudflare/workers-oauth-provider": "1.2.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@eslint/js": "10.0.0",
    "@types/node": "22.20.2",
    "eslint": "10.0.0",
    "prettier": "3.9.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0",
    "@cloudflare/workers-types": "5.20261009.1"
  }
}
